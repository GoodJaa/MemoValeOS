# `mv` in Knowledge-OS/Dist/plugin/, which the personal install
# (adopt.mjs --local) installs instead of copying commands into .claude/.
# Generated by Knowledge-OS/Tools/build-plugin.mjs. A dot-folder, so the
# validator never walks it; this line is what carries it.
.claude-plugin/marketplace.json

